# Copy this file to .env and fill in what you need.
# Nothing here is required to get started — the server works out of
# the box, storing contact form submissions in server/data/submissions.json.

# Port the server runs on
PORT=3000

# --- Optional: real email delivery ---
# Leave these blank to skip email and just store submissions locally.
# For Gmail, use an "App Password" rather than your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=longchaseenterpriselimited@gmail.com
CONTACT_FROM_EMAIL=website@longchase.co.ke

# --- Optional: view stored submissions during development ---
# Set this to any secret string, then visit /api/contact with header
#   x-admin-token: <the same string>
# to view stored submissions as JSON. Leave blank to keep it disabled.
ADMIN_TOKEN=
